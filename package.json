{
  "name": "onyxia-tank-sim",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Standalone tank rehearsal simulator for the WoW Classic Onyxia encounter",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "serve": "npm run build && node tools/serve.mjs",
    "build": "prisma generate && node tools/build.mjs",
    "dev": "npm run serve",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prisma": "^7.10.1"
  },
  "engines": {
    "node": "24.x"
  }
}
