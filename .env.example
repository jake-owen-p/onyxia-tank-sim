# Server only. Use Supabase's transaction pooler for DATABASE_URL and its
# session pooler (or direct connection) for Prisma migrations via DIRECT_URL.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:5432/postgres
SUPABASE_URL=https://PROJECT.supabase.co
# Public publishable/anon key; never put a service-role key here.
SUPABASE_PUBLISHABLE_KEY=
SITE_URL=https://www.raidrehearsal.com
