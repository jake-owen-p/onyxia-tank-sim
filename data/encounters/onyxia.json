  "tutorial": {
    "steps": [
      {
        "id": "welcome",
        "title": "Onyxia's Lair",
        "text": "This is Onyxia's Lair. You came down the ramp from the south. The raid will gather in the centre. The back wall is where you will tank her.\n\nPress Tab to switch between the top-down map and the over-the-shoulder view.",
        "setup": {
          "bossPassive": true,
          "phase": 1,
          "start": "entrance"
        },
        "done": {
          "type": "viewToggledOrWait",
          "seconds": 8
        }
      },
      {
        "id": "move",
        "title": "Move to the tank spot",
        "text": "Move with W A S D. Q and E strafe. Hold the right mouse button to turn with the mouse.\n\nFollow the glowing path and the ghost tank to the tank spot on the back wall.",
        "setup": {
          "ghost": true
        },
        "done": {
          "type": "playerAtSpot",
          "spot": "tankSpot"
        }
      },
      {
        "id": "pull",
        "title": "Pull and position",
        "text": "Onyxia faces whoever she is attacking. Walk to her, press Taunt (1), then walk back to the wall. She will follow you and face the wall, away from the raid.\n\nDotted outlines show where she should stand and face.",
        "setup": {
          "bossPassive": false,
          "ghost": true
        },
        "done": {
          "type": "bossAtSpot",
          "spot": "bossSpot",
          "hold": 3
        }
      },
      {
        "id": "rotation",
        "title": "Sunder Armor and the press lane",
        "text": "Threat comes from Sunder Armor. Notes fall down the lane above your bar: press the key when a note reaches its icon. Sunder (2) comes every global; her debuff tray shows the stacks.\n\nShield Block (3) notes appear before Flame Breath, Berserker Rage (5) before Bellowing Roar, Taunt (1) when she turns. Perfect presses build a combo.\n\nBuild five Sunder stacks now.",
        "done": {
          "type": "debuffStacks",
          "debuff": "sunder",
          "stacks": 5
        }
      },
      {
        "id": "breath",
        "title": "Flame Breath",
        "text": "Flame Breath is a three second cast that hits a cone in front of her. You take it. The raid must not.\n\nHold your position, watch the cast bar, and press Shield Block (3) when its note reaches the icon.",
        "trigger": "flameBreath",
        "done": {
          "type": "eventLanded",
          "event": "flameBreath",
          "metricUnchanged": "raidInBreath"
        }
      },
      {
        "id": "buffet",
        "title": "Wing Buffet",
        "text": "Wing Buffet knocks you back and cuts your threat. With the wall behind you the knockback goes nowhere.\n\nAfter it lands, keep hitting Sunder (2) on every note until your threat bar leaves the danger band, and Taunt if she turns.",
        "trigger": "wingBuffet",
        "done": {
          "type": "expectation",
          "id": "rebuild"
        }
      },
      {
        "id": "takeoff",
        "title": "Phase 2: airborne",
        "text": "At 65% she takes off. Fireballs hit random raid members. Move to the pickup spot north of the centre and wait.",
        "setup": {
          "phase": 2,
          "ghost": true
        },
        "done": {
          "type": "playerAtSpot",
          "spot": "pickupSpot"
        }
      },
      {
        "id": "lane",
        "title": "Deep Breath",
        "text": "Deep Breath has a five second warning, then fire fills a lane across the room. Step sideways out of the lane, then return to the pickup spot.",
        "trigger": "deepBreath",
        "done": {
          "type": "expectation",
          "id": "lane"
        }
      },
      {
        "id": "landing",
        "title": "Phase 3: the landing",
        "text": "At 40% she lands in the centre with her threat reset. Taunt her within five seconds, Sunder twice, then walk backwards to the wall between the cracks.",
        "setup": {
          "phase": 3,
          "ghost": true
        },
        "done": {
          "type": "bossAtSpot",
          "spot": "bossSpot",
          "hold": 2
        }
      },
      {
        "id": "roar",
        "title": "Bellowing Roar",
        "text": "Bellowing Roar fears the whole raid. If you are feared she walks through the raid. Press Berserker Rage (5) when its note reaches the icon, before the cast finishes.",
        "trigger": "bellowingRoar",
        "done": {
          "type": "expectation",
          "id": "roar"
        }
      },
